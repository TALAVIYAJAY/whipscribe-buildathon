# WhipScribe API Configuration
# Get your API key from WhipScribe Account -> API key (https://whipscribe.com)
WHIPSCRIBE_API_KEY=your_whipscribe_api_key_here

# Airtable Configuration
# Personal Access Token with data.records:read and data.records:write scope
AIRTABLE_API_TOKEN=pat_your_airtable_token_here
AIRTABLE_BASE_ID=app_your_base_id_here
AIRTABLE_TABLE_NAME=Table 1

# Google Gemini API Configuration
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_MODEL=gemini-3.5-flash
